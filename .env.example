# 复制为 .env 后生效。界面中保存的配置优先于本文件。

# 任何 OpenAI 兼容接口，注意通常需要以 /v1 结尾
# EDU_BASE_URL=https://api.deepseek.com/v1
# EDU_MODEL=deepseek-chat
# EDU_API_KEY=

# 服务监听地址与端口（端口为 0 时自动选择 8000 起的空闲端口）
# EDU_HOST=127.0.0.1
# EDU_PORT=8000

# 启动后是否自动打开浏览器（1 开启，0 关闭）
# EDU_OPEN_BROWSER=1

# 数据目录，默认为 edu/data
# EDU_DATA_DIR=

# 生成类 / 登录 / 上传接口的每分钟限流（0 关闭，默认 120）
# EDU_RATE_LIMIT=120

# 检索模式：bm25 / dense / hybrid / hybrid_rerank（默认 hybrid；没装 fastembed 时自动退回 bm25）
# EDU_RETRIEVAL_MODE=hybrid
# 混合检索里向量那一路的 RRF 权重（默认 1.0）
# EDU_RETRIEVAL_DENSE_WEIGHT=1.0
# 向量模型（默认 BAAI/bge-small-zh-v1.5），国内下载可配合 HF_ENDPOINT=https://hf-mirror.com
# EDU_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 模型缓存目录，默认 data/models
# EDU_MODEL_CACHE=
