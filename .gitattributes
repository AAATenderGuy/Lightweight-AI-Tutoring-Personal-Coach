# 统一换行符。
#
# 本机 core.autocrlf=true，检出时会把文件改成 CRLF；而 deploy.sh / start.sh 一旦带上
# CRLF，在 Linux 上会直接报 `/usr/bin/env: 'bash\r': No such file or directory`。
# 这里对脚本强制 LF，避免「本机能跑、服务器拉下来就跑不了」。
* text=auto

*.sh       text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.sql      text eol=lf
*.md       text eol=lf
*.vue      text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.txt      text eol=lf
Dockerfile text eol=lf

# Windows 批处理必须是 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 图片一律按二进制处理，避免被当作文本改写
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.webp     binary
